# ==========================================================
# BhashaBridge AI - Python AI Engine Environment Configuration
# ==========================================================
# STRICTLY FREE-FIRST: OpenRouter Free Models
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Sarvam AI Integration (DISABLED by default, enable only with verified free quota)
SARVAM_API_KEY=
ENABLE_SARVAM_STT=false
ENABLE_SARVAM_TTS=false

# Vector DB & Embeddings
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Java Backend and CORS
JAVA_BACKEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
HOST=0.0.0.0
PORT=8000
