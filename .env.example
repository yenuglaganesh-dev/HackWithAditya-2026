# BhashaBridge AI - Environment Configuration Example
# Copy this file to .env and provide your secret credentials.
# NEVER commit the actual .env file with real keys.

# AI Provider Configuration (Server-Side Only)
AI_API_KEY=your_ai_provider_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Server Ports
PORT=8000
JAVA_GATEWAY_PORT=8080

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
